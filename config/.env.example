# AirWave NMS connection
AIRWAVE_URL=https://192.168.240.196
AIRWAVE_USERNAME=your_user
AIRWAVE_PASSWORD=your_password
AIRWAVE_POLL_INTERVAL_SECONDS=20
AIRWAVE_POLL_TIMEOUT_MINUTES=5
AIRWAVE_MAX_RETRIES=3

# Paths
REPORT_BASE_DIR=Report/Switch
TEMPLATES_DIR=config/templates

# Optional WhatsApp notifications via GOWA gateway
GOWA_BASE_URL=
GOWA_TARGET_JID=
GOWA_DEVICE_ID=
GOWA_TIMEOUT_SECONDS=5.0

# Timezone
TIMEZONE=Asia/Jakarta
